DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_GUILD_ID=your_test_discord_server_id

# Optional: name of the Discord role allowed to use admin commands.
ADMIN_ROLE_NAME=Admin

# Web panel
PORT=3001
# Public base URL where the panel/login page is reachable (used by /pair links).
# e.g. https://rustbot.example.com  — defaults to http://localhost:PORT
PUBLIC_URL=
PANEL_USERNAME=admin
PANEL_PASSWORD=change-this-password

# Optional: Steam Web API key, used for /checkgamebans and richer player lookups.
STEAM_API_KEY=

# Rust+ pairing details. Leave blank until you have paired with your Rust server.
RUST_SERVER_IP=
RUST_APP_PORT=
RUST_PLAYER_ID=
RUST_PLAYER_TOKEN=
